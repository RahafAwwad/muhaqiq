{
  "manifest_version": 3,
  "name": "Muhaqiq — مُحقِّق",
  "version": "0.1",
  "description": "يكتشف الآيات والأحاديث في الصفحة",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://x.com/*", "https://islamqa.info/*"],
    "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"
  }],
    "background": { "service_worker": "background.js" },
  "host_permissions": ["https://*.modal.run/*"]}